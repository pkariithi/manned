  "metadata": {
    "name": "groupmod",
    "displayName": "groupmod - Modify a group",
    "category": "User & Permissions",
    "tags": ["group", "modify", "admin", "permissions", "intermediate"],
    "description": "Modify an existing group",
    "popularity": 4,
